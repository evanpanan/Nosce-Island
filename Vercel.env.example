# Minimum required configuration for a real password-protected admin on Vercel.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Worker only: direct/unpooled URL to the same database (do not use a transaction pooler).
WORKER_DATABASE_URL=
TOKEN_ENCRYPTION_KEY=GENERATE_64_HEX_CHARACTERS_ON_YOUR_MAC
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SET_YOUR_OWN_PASSWORD_AT_LEAST_14_CHARACTERS
# Optional: set only if you want authenticator-based verification.
ADMIN_TOTP_SECRET=
# Keep sales off until paid features/products and Apple Sandbox are validated.
COMMERCE_SALES_ENABLED=false
# Optional Apple configuration; multiline PEM can use literal \n escapes.
APPLE_BUNDLE_ID=com.cooper.nosceisland
APNS_ENVIRONMENT=development
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APP_STORE_ENVIRONMENT=Sandbox
APP_STORE_ISSUER_ID=
APP_STORE_KEY_ID=
APP_STORE_PRIVATE_KEY=
APP_STORE_ROOT_CERTIFICATES_BASE64=
APP_STORE_APP_ID=
APP_STORE_PRODUCT_IDS=
PUBLIC_PRIVACY_URL=
PUBLIC_TERMS_URL=

# Optional public website downloads (also editable in Admin > Services)
PUBLIC_IOS_DOWNLOAD_URL=
PUBLIC_ANDROID_DOWNLOAD_URL=
