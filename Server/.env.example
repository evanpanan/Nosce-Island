NOSCE_DOMAIN=api.your-domain.com
DATABASE=/data/nosce.sqlite3
# Generate once with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Persist and back up this key with the DB. Changing it makes stored push tokens unreadable.
TOKEN_ENCRYPTION_KEY=
APPLE_BUNDLE_ID=com.cooper.nosceisland
APNS_ENVIRONMENT=production
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_KEY_FILE=/run/secrets/AuthKey.p8
PUSH_INTERVAL_SECONDS=15
MAX_SESSIONS=10000
MAX_ACTIVE_SYMBOLS=64
# Keep disabled until external-display rights are confirmed for the actual markets/feed.
TWELVE_DATA_API_KEY=
TWELVE_DATA_EXTERNAL_DISPLAY_LICENSED=false
TWELVE_DATA_WEBSOCKET_ENABLED=false
# -1 disables a market. Set 0 for licensed real-time, or the actual licensed delay in seconds.
TWELVE_DATA_US_DELAY_SECONDS=-1
TWELVE_DATA_HK_DELAY_SECONDS=-1
STOCK_REQUESTS_PER_MINUTE=60

# No market-data API registration/key is needed for Binance or Hyperliquid.
BINANCE_ENABLED=true

# Admin requires a password. TOTP is optional.
# Generate locally on the server: python -m nosce.admin_setup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional advanced replacement for ADMIN_PASSWORD:
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=

# Legacy sign-in endpoints only; the current anonymous app does not use these.
APPLE_SIGNIN_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_KEY_FILE=

# App Store Server API / Notifications V2. These are Apple developer settings.
APP_STORE_ENVIRONMENT=Production
APP_STORE_APP_ID=0
APP_STORE_ROOT_CERTIFICATES=
APP_STORE_ISSUER_ID=
APP_STORE_KEY_ID=
APP_STORE_KEY_FILE=
APP_STORE_PRODUCT_IDS=
PUBLIC_PRIVACY_URL=
PUBLIC_TERMS_URL=
# Keep false until paid features and product terms are defined and implemented,
# native + sandbox + production verification passes, and approved products are configured.
COMMERCE_SALES_ENABLED=false

# Vercel uses the root Vercel.env.example and persistent PostgreSQL.
# Private PEM values can replace key file paths in serverless deployments.
APNS_PRIVATE_KEY=
APP_STORE_PRIVATE_KEY=
APP_STORE_ROOT_CERTIFICATES_BASE64=
WORKER_DATABASE_URL=
